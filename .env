# =========================
# Database
# =========================
DB_URL=jdbc:postgresql://localhost:5433/guardrail_db
DB_USERNAME=guardrail
DB_PASSWORD=guardrail_secret

# =========================
# Redis
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true

# =========================
# Semantic Validation
# =========================
SEMANTIC_ENABLED=true
SEMANTIC_SIMILARITY_THRESHOLD=0.65
SEMANTIC_TOP_K=10

# =========================
# ONNX
# =========================
ONNX_MODEL_PATH=/Users/prsingh/models/bge-small-en/onnx/model.onnx
TOKENIZER_PATH=/Users/prsingh/models/bge-small-en/tokenizer.json
ONNX_MAX_TOKENS=128
ONNX_THREADS=1

POSTGRES_DB=guardrail_db
POSTGRES_USER=guardrail
POSTGRES_PASSWORD=guardrail_secret